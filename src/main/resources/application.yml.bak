server:
  port: 8080

spring:
  profiles:
    active: dev
  main:
    allow-circular-references: true
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3305/eventhub?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8&zeroDateTimeBehavior=convertToNull&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: root
  alioss:
    endpoint: xxx
    access-key-id: xxx
    access-key-secret: xxxx
    bucket-name: bubbleovo
    cdn-domain: xxx

mybatis:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.bubbles.eventhub.entity
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.slf4j.Slf4jImpl

springdoc:
  api-docs:
    path: /v3/api-docs
  swagger-ui:
    path: /swagger-ui.html
    operations-sorter: method
    tags-sorter: alpha
    try-it-out-enabled: true
  group-configs: public
  default-group: public

jwt:
  secret: eventhub_secret_key_2026_must_be_at_least_256_bits_long_for_hs256_algorithm
  expiration: 7200000

logging:
  level:
    root: INFO
    com.bubbles: DEBUG
    org.mybatis: DEBUG
    org.springframework.web: INFO